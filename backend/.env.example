# PostgreSQL connection string used by Prisma at runtime.
# Use a pooled connection string in production (PgBouncer, Neon pooler, etc.).
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Direct (non-pooled) connection used by `prisma migrate` / `prisma db pull`.
# Can be the same as DATABASE_URL if your provider does not offer a pooler.
DIRECT_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Strong random secret used to sign session JWTs.
JWT_SECRET="replace-with-a-long-random-value"

# Exact browser origin allowed to make credentialed requests.
# Local development: http://localhost:3000
# Vercel: https://your-frontend.vercel.app
FRONTEND_URL="http://localhost:3000"

# Optional local HTTP port (ignored by Vercel Functions).
PORT=3001
